{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "asa1984-api",
  "compatibility_date": "2026-08-01",

  "main": "src/main.ts",

  "observability": {
    "enabled": true,
  },

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "asa1984-image",
    },
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "asa1984-blog",
      "database_id": "79856d54-a73b-481f-bb34-7a56ba8b993b",
      "migrations_dir": "../drizzle/migrations",
    },
  ],
}
