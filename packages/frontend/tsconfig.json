{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* Next.js */
    "jsx": "preserve",
    // The generated worker-configuration.d.ts redeclares the DOM types.
    "skipLibCheck": true,
    "allowJs": true,
    "incremental": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "plugins": [
      {
        "name": "next"
      }
    ],

    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["./worker-configuration.d.ts"]
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    "panda.config.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules"]
}
