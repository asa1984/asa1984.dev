{
  "extends": "@asa1984/configs/tsconfig",
  "compilerOptions": {
    /* Next.js */
    "target": "ES2022",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "plugins": [
      {
        "name": "next"
      }
    ],

    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["./worker-configuration.d.ts"]
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    "panda.config.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules"]
}
