{
  "name": "@asa1984.dev/frontend",
  "private": true,
  "main": "src/lib.ts",
  "scripts": {
    "gen": "pnpm run gen:css && pnpm run gen:schema && pnpm run gen:gql && pnpm run gen:types",
    "gen:css": "panda codegen",
    "gen:gql": "nitrogql generate",
    "gen:schema": "tsx scripts/gen-gql-schema.ts",
    "gen:types": "wrangler types",
    "watch": "chokidar '**/*.graphql' --initial --command 'pnpm gen:gql'",
    "typecheck": "tsc",
    "dev": "rimraf ./next && next dev",
    "build": "next build",
    "start": "opennextjs-cloudflare build && opennextjs-cloudflare populateCache local && wrangler dev --port 3000 --var BACKEND_URL:$BACKEND_URL BACKEND_API_TOKEN:$BACKEND_API_TOKEN FRONTEND_URL:$FRONTEND_URL FRONTEND_API_TOKEN:$FRONTEND_API_TOKEN",
    "deploy:secret": "node -e 'process.stdout.write(JSON.stringify({ BACKEND_API_TOKEN: process.env.BACKEND_API_TOKEN, FRONTEND_API_TOKEN: process.env.FRONTEND_API_TOKEN }))' | wrangler secret bulk",
    "staging": "opennextjs-cloudflare upload -- --var BACKEND_URL:$BACKEND_URL FRONTEND_URL:$FRONTEND_URL",
    "staging:secret": "node -e 'process.stdout.write(JSON.stringify({ BACKEND_API_TOKEN: process.env.BACKEND_API_TOKEN, FRONTEND_API_TOKEN: process.env.FRONTEND_API_TOKEN }))' | wrangler versions secret bulk",
    "build:prod": "opennextjs-cloudflare build",
    "deploy:prod": "opennextjs-cloudflare deploy -- --var BACKEND_URL:$BACKEND_URL FRONTEND_URL:$FRONTEND_URL",
    "test": "vitest run"
  },
  "dependencies": {
    "@asa1984.dev/backend": "workspace:*",
    "@asa1984.dev/graphql": "workspace:*",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "@fontsource-variable/noto-emoji": "catalog:",
    "@fontsource-variable/noto-sans-jp": "catalog:",
    "@mdx-js/mdx": "catalog:",
    "@pandacss/dev": "catalog:",
    "@types/mdast": "catalog:",
    "@urql/core": "catalog:",
    "feed": "catalog:",
    "hono": "catalog:",
    "katex": "catalog:",
    "mdast-util-to-hast": "catalog:",
    "next": "catalog:",
    "next-mdx-remote": "catalog:",
    "node-html-parser": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-icons": "catalog:",
    "rehype-katex": "catalog:",
    "rehype-pretty-code": "catalog:",
    "remark-breaks": "catalog:",
    "remark-comment": "catalog:",
    "remark-gemoji": "catalog:",
    "remark-gfm": "catalog:",
    "remark-math": "catalog:",
    "sass": "catalog:",
    "sharp": "catalog:",
    "shiki": "catalog:",
    "unified": "catalog:",
    "unist-util-visit": "catalog:",
    "urql": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@asa1984.dev/tsconfig": "workspace:*",
    "@graphql-typed-document-node/core": "catalog:",
    "@nitrogql/cli": "catalog:",
    "@nitrogql/graphql-loader": "catalog:",
    "@opennextjs/cloudflare": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/unist": "catalog:",
    "chokidar-cli": "catalog:",
    "graphql": "catalog:",
    "remark-parse": "catalog:",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
