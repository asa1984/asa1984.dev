{
  "name": "@asa1984.dev/frontend",
  "private": true,
  "scripts": {
    "gen": "pnpm run gen:css && pnpm run gen:types",
    "gen:css": "panda codegen",
    "gen:types": "wrangler types",
    "typecheck": "tsc",
    "dev": "rimraf ./next && next dev",
    "build": "next build",
    "start": "opennextjs-cloudflare build && opennextjs-cloudflare populateCache local && wrangler dev --port 3000 --var ALLOW_EMPTY_CONTENT:${ALLOW_EMPTY_CONTENT:-1} --var CONTENT_GITHUB_TOKEN:${CONTENT_GITHUB_TOKEN:-local-dummy} --var CONTENT_WEBHOOK_SECRET:${CONTENT_WEBHOOK_SECRET:-local-dev}",
    "build:worker": "opennextjs-cloudflare build",
    "deploy:dev": "CLOUDFLARE_ENV=dev opennextjs-cloudflare deploy -- --env dev",
    "deploy:production": "CLOUDFLARE_ENV=production opennextjs-cloudflare deploy -- --env production",
    "secret:dev": "node -e 'process.stdout.write(JSON.stringify({ CONTENT_GITHUB_TOKEN: process.env.CONTENT_GITHUB_TOKEN, CONTENT_WEBHOOK_SECRET: process.env.CONTENT_WEBHOOK_SECRET }))' | wrangler secret bulk --env dev",
    "secret:production": "node -e 'process.stdout.write(JSON.stringify({ CONTENT_GITHUB_TOKEN: process.env.CONTENT_GITHUB_TOKEN, CONTENT_WEBHOOK_SECRET: process.env.CONTENT_WEBHOOK_SECRET }))' | wrangler secret bulk --env production",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "@fontsource-variable/noto-emoji": "catalog:",
    "@fontsource-variable/noto-sans-jp": "catalog:",
    "@pandacss/dev": "catalog:",
    "@types/hast": "catalog:",
    "@types/mdast": "catalog:",
    "feed": "catalog:",
    "hast-util-to-jsx-runtime": "catalog:",
    "katex": "catalog:",
    "mdast-util-to-hast": "catalog:",
    "next": "catalog:",
    "node-html-parser": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-icons": "catalog:",
    "rehype-katex": "catalog:",
    "rehype-pretty-code": "catalog:",
    "rehype-raw": "catalog:",
    "remark-breaks": "catalog:",
    "remark-gemoji": "catalog:",
    "remark-gfm": "catalog:",
    "remark-math": "catalog:",
    "remark-parse": "catalog:",
    "remark-rehype": "catalog:",
    "sass": "catalog:",
    "sharp": "catalog:",
    "shiki": "catalog:",
    "unified": "catalog:",
    "unist-util-visit": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@asa1984.dev/tsconfig": "workspace:*",
    "@opennextjs/cloudflare": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/unist": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
