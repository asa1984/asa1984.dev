use flake

# vp (Vite+) is installed as a project-level pnpm dependency; expose its bin
# (and every other workspace bin) on PATH instead of installing it globally.
PATH_add node_modules/.bin

# apps/web がページの絶対 URL(og:image、RSS)を組み立てる起点。
# デプロイのワークフローは環境ごとの URL を渡す。
export VITE_SITE_URL=http://localhost:5173
