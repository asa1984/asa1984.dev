{
  "name": "asa1984.dev",
  "private": true,
  "description": "asa1984's personal website",
  "type": "module",
  "scripts": {
    "gen": "pnpm -r run gen",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm -r run gen && pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "dev": "pnpm -r run gen && dotenvx run -- pnpm -r --parallel run dev",
    "build": "pnpm -r run gen && dotenvx run -- pnpm -r run build",
    "start": "dotenvx run -- pnpm -r --parallel run start",
    "sync": "dotenvx run -- pnpm --filter @asa1984.dev/cli run sync",
    "migrate:dev": "dotenvx run -- pnpm --filter @asa1984.dev/backend run migrate:dev",
    "migrate:prod": "dotenvx run -- pnpm --filter @asa1984.dev/backend run migrate:prod",
    "deploy": "dotenvx run -- pnpm --filter @asa1984.dev/backend run deploy",
    "deploy:secret": "dotenvx run -- pnpm -r --workspace-concurrency=1 run deploy:secret",
    "staging": "pnpm run build && dotenvx run -- pnpm -r --workspace-concurrency=1 run staging",
    "staging:secret": "dotenvx run -- pnpm -r --workspace-concurrency=1 run staging:secret",
    "build:frontend": "pnpm -r run gen && dotenvx run -- pnpm run --filter=frontend build:prod",
    "deploy:frontend": "dotenvx run -- pnpm run --filter=frontend deploy:prod"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "1.26.0",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "wrangler": "catalog:"
  },
  "packageManager": "pnpm@10.24.0"
}
